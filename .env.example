# ── GitHub ──────────────────────────────────────────────
# Personal Access Token (fine-grained, public repos read-only)
# Get it at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Snowflake ────────────────────────────────────────────
# Account identifier format: orgname-accountname  (no https://, no .snowflakecomputing.com)
SNOWFLAKE_ACCOUNT=orgname-accountname

# Service user for ingestion (created in snowflake/00_setup.sql)
SNOWFLAKE_USER=SVC_INGEST

# Absolute path to your locally-generated private key file (rsa_key.p8)
# Generate with: openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8 -nocrypt
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/rsa_key.p8
